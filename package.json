{
  "name": "api-testing-framework",
  "version": "1.0.0",
  "description": "Production-style REST API testing framework built with TypeScript and Playwright APIRequestContext",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test",
    "test:schema": "playwright test tests/schema",
    "test:negative": "playwright test tests/negative",
    "test:boundary": "playwright test tests/boundary",
    "test:sla": "playwright test tests/performance",
    "test:headed": "playwright test --headed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "typescript",
    "rest-api",
    "automation",
    "sdet",
    "qa-engineering",
    "zod",
    "schema-validation",
    "faker",
    "sla-testing"
  ],
  "author": "Helin Aslanoglu",
  "license": "ISC",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.1.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3"
  }
}
